<policies>
  <inbound>
    <base />
    <!--
      Routing policy for Fabric GraphQL endpoints.
      JWT validation is enforced by the APIM global policy (BCGov Entra issuer).
      The Authorization Bearer token is forwarded as-is to Fabric.
      Fabric performs its own authorization.

      Tenant:  ${tenant_name}
      Product: ${product_name}

      URL pattern: POST /{tenant}/{product}/graphql/{endpoint-name}
        e.g. POST /${tenant_name}/${product_name}/graphql/my-endpoint
    -->
    <set-header name="X-Tenant-Id" exists-action="override">
      <value>${tenant_name}</value>
    </set-header>
    <set-header name="X-Product-Id" exists-action="override">
      <value>${product_name}</value>
    </set-header>
    <set-header name="X-Endpoint-Type" exists-action="override">
      <value>graphql</value>
    </set-header>
    <!--
      Route to the correct Fabric GraphQL endpoint.
      The endpoint name is matched as an exact path segment so partial matches
      (e.g. "data" vs "data-v2") are not conflated.
    -->
    <choose>
%{ for endpoint in endpoints ~}
      <when condition="@(context.Request.Url.Path.Split('/').Any(s => s == "${endpoint.name}"))">
        <set-backend-service base-url="${endpoint.backend_url}" />
        <rewrite-uri template="/" copy-unmatched-params="false" />
      </when>
%{ endfor ~}
      <otherwise>
        <return-response>
          <set-status code="404" reason="Not Found" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"error": "GraphQL endpoint not found", "valid_endpoints": [${join(", ", [for e in endpoints : "\"${e.name}\""])}], "hint": "Include the endpoint name as the next path segment after /graphql/"}</set-body>
        </return-response>
      </otherwise>
    </choose>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
