<policies>
  <inbound>
    <!-- Set correlation ID for request tracing -->
    <set-header name="x-ms-correlation-request-id" exists-action="skip">
        <value>@(context.RequestId.ToString())</value>
    </set-header>
    <!--
      Global JWT validation — applied to ALL APIs in this APIM instance.
      Every inbound request must carry a valid BCGov Entra Bearer token.
      Fabric performs its own authorization once the token is forwarded.

      {{bcgov-entra-tenant-id}} is an APIM Named Value set by Terraform.
    -->
    <validate-jwt header-name="Authorization"
                  failed-validation-httpcode="401"
                  failed-validation-error-message="Unauthorized — a valid BCGov Entra ID token is required">
      <openid-config url="https://login.microsoftonline.com/{{bcgov-entra-tenant-id}}/v2.0/.well-known/openid-configuration" />
      <!--
        Accept BOTH v1.0 and v2.0 token issuers for the tenant. Fabric / Power BI
        tokens (aud = analysis.windows.net/powerbi/api) are issued as v1.0 with the
        sts.windows.net issuer; without this, APIM validates iss against only the
        v2.0 metadata issuer and rejects valid v1.0 tokens with 401.
      -->
      <issuers>
        <issuer>https://sts.windows.net/{{bcgov-entra-tenant-id}}/</issuer>
        <issuer>https://login.microsoftonline.com/{{bcgov-entra-tenant-id}}/v2.0</issuer>
      </issuers>
    </validate-jwt>
  </inbound>
  <backend>
    <!-- At the global (service) scope there is no parent policy, so <base/> is
         illegal here; <forward-request/> performs the default backend forward. -->
    <forward-request />
  </backend>
  <outbound>
    <!-- Strip server fingerprinting headers -->
    <set-header name="X-Powered-By" exists-action="delete" />
    <set-header name="X-AspNet-Version" exists-action="delete" />
  </outbound>
  <on-error />
</policies>
