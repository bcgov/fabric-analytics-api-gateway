# Default: normalize line endings to LF in the repository
* text=auto eol=lf

# Explicitly text files — enforce LF
*.tf        text eol=lf
*.hcl       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.env       text eol=lf
*.example   text eol=lf
*.gitignore text eol=lf
*.editorconfig text eol=lf
*.gitattributes text eol=lf
LICENSE     text eol=lf

# Binary files — do not diff or convert
*.exe       binary
*.zip       binary
