{
  "data-source": {
    "database-type": "dwsql",
    "connection-string": "@env('SQL_CONN_STRING')"
  },
  "runtime": {
    "rest": { "enabled": true, "path": "/api" },
    "graphql": { "enabled": true, "path": "/graphql" },
    "host": {
      "mode": "development",
      "authentication": { "provider": "StaticWebApps" }
    },
    "telemetry": {
      "log-level": {
        "Azure.DataApiBuilder.Core.Configurations.RuntimeConfigValidator": "Debug",
        "Azure.DataApiBuilder.Core": "Debug",
        "default": "Warning"
      }
    }
  },
  "entities": {
    "NaturalResourceBoundary": {
      "source": {
        "object": "admin_boundary.adm_natural_resource_bndries_poly",
        "type": "table"
      },
      "permissions": [{ "role": "anonymous", "actions": ["read"] }],
      "rest": {
        "enabled": true,
        "path": "natural-resource-boundaries"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "NaturalResourceBoundary",
          "plural": "NaturalResourceBoundaries"
        }
      }
    },
    "NaturalResourceRegion": {
      "source": {
        "object": "admin_boundary.adm_natural_resource_regions_gen",
        "type": "table"
      },
      "permissions": [{ "role": "anonymous", "actions": ["read"] }],
      "rest": {
        "enabled": true,
        "path": "natural-resource-regions"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "NaturalResourceRegion",
          "plural": "NaturalResourceRegions"
        }
      }
    }
  }
}
