# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
# Local working directories created by `terraform init` / the deploy scripts.
.terraform/
.terraform-data/

# State files — never commit. Remote state lives in the azurerm backend.
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Plan output files.
*.tfplan
tfplan
tfplan.*

# Terraform CLI override files (used for local overrides only).
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive / environment-specific variable values.
# Real tenant.tfvars hold Fabric workspace IDs and are excluded; the committed
# *.tfvars.example templates are kept. Shared *.tfvars carry placeholders only.
**/tenants/**/tenant.tfvars
*.auto.tfvars
*.auto.tfvars.json

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.log

# Agent scratch state (Copilot/Claude local memory) — never commit.
.copilot-memory/
